    {
      "playerId": "4374302",
      "name": "Amon-Ra St. Brown",
      "position": "WR",
      "jersey": 14,
      "headshotUrl": "https://a.espncdn.com/i/headshots/nfl/players/full/4374302.png",
      "rosterBucket": "active",
      "isIrReturnWindow": false,
      "sustainedInLastGame": false,
      "wed": "-",
