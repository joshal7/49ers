    {
      "playerId": "5123663",
      "name": "Isaac TeSlaa",
      "position": "WR",
      "jersey": 18,
      "headshotUrl": "https://a.espncdn.com/i/headshots/nfl/players/full/5123663.png",
      "rosterBucket": "active",
