    {
      "playerId": "3046779",
      "name": "Jared Goff",
      "position": "QB",
      "jersey": 16,
      "headshotUrl": "https://a.espncdn.com/i/headshots/nfl/players/full/3046779.png",
      "rosterBucket": "active",
      "isIrReturnWindow": false,
      "sustainedInLastGame": false,
