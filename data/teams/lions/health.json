      "priorDayPlayProbabilityPct": null,
      "hasPreReportPracticeReturnDelta": false,
      "isMidWeekAdditionDelta": false,
      "archetypeNote": "",
      "factors": [
        "Cleared without restrictive game-day designation"
      ],
      "beatComment": "Drake Maye (ankle) got knocked out of the game early for New England, setting the stage for the rout, and Gibbs took full advantage as he set new season highs in receiving yards and scrimmage yards. It's the fourth time in 2026 that the star RB has topped 150 rushing yards, and his fourth game with multiple TDs. Gibbs has amassed 1,384 scrimmage yards and 13 total touchdowns through nine contests as he gets ready to face a stingy Buccaneers run defense in Week 11."
    },
    {
      "playerId": "4426388",
      "name": "Jameson Williams",
      "position": "WR",
      "jersey": 1,
      "headshotUrl": "https://a.espncdn.com/i/headshots/nfl/players/full/4426388.png",
