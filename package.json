{
  "name": "49ers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "49ers Faithful (49ers.joshal.com) — High-signal San Francisco 49ers analytics, cap simulator, injury models, playoff Monte Carlo, news/film synthesis, and Autopodcast PWA.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "refresh-data": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/refresh-all-nfl-teams.mjs",
    "refresh-data:sf": "node scripts/fetch-live-49ers-data.mjs",
    "refresh-data:seasonal": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/refresh-all-nfl-teams.mjs --seasonal-only",
    "update-reporters": "node scripts/update-reporter-registry.mjs",
    "build-podcasts": "node scripts/build-podcasts.mjs",
    "build-team-icons": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/build-team-icons.mjs --all",
    "build-team-icons:all": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/build-team-icons.mjs --all",
    "build:nfl": "node scripts/build-nfl-portal.mjs",
    "deploy:nfl": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/deploy-nfl-portal.mjs",
    "test:nfl": "node tests/nfl-portal-qa.mjs",
    "refresh-all-teams": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/refresh-all-nfl-teams.mjs",
    "build:nfl-teams": "node scripts/build-nfl-teams-pages.mjs",
    "deploy:nfl-teams": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem node scripts/deploy-nfl-teams.mjs",
    "test:32teams": "node tests/all-32-teams-qa.mjs",
    "test:unit": "node tests/unit-engines-qa.mjs && node tests/holistic-qa-regressions.mjs && node tests/timeliness-simulation-qa.mjs",
    "test:e2e": "node tests/e2e-mobile-qa.mjs",
    "test": "node tests/unit-engines-qa.mjs && node tests/holistic-qa-regressions.mjs && node tests/timeliness-simulation-qa.mjs && node tests/e2e-mobile-qa.mjs",
    "test:all": "npm test && npm run test:nfl && npm run test:32teams"
  }
}
