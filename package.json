{
  "name": "49ers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "49ers Faithful (49ers.joshal.com) — High-signal San Francisco 49ers analytics, cap simulator, injury models, playoff Monte Carlo, news/film synthesis, and Autopodcast PWA.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "refresh-data": "node scripts/fetch-live-49ers-data.mjs",
    "update-reporters": "node scripts/update-reporter-registry.mjs",
    "build-podcasts": "node scripts/build-podcasts.mjs",
    "test:unit": "node tests/unit-engines-qa.mjs",
    "test:e2e": "node tests/e2e-mobile-qa.mjs",
    "test": "node tests/unit-engines-qa.mjs && node tests/e2e-mobile-qa.mjs"
  }
}
