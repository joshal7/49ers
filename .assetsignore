# Cloudflare Workers Static Assets ignore list for `nfl-hq-canary`
# Ensures ONLY the web app shell, `src/`, `assets/`, `data/league/`, and `data/teams/` are uploaded.
.git
.github
.agents
.gitignore
.DS_Store
node_modules
worker
scripts
tests
config
docs
*.md
package.json
package-lock.json
CNAME
data/podcasts/*.m4a
data/*.json
